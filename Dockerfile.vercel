# Vercel Container Runtime image (https://vercel.com/docs/functions/runtimes/container)

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src ./src

RUN pip install --no-cache-dir .

EXPOSE 80
CMD ["sh", "-c", "exec uvicorn polilean.api:app --host 0.0.0.0 --port ${PORT:-80}"]
